#include <bits/stdc++.h>
using namespace std;

int main() {
    int n, m;
    cin >> n >> m;


    if (m < 2) {
        cout << "NO" << endl;
        return 0;
    }

    for (int i = 2; 1LL * i * i <= m; i++) {
        if (m % i == 0) {
            cout << "NO" << endl;
            return 0;
        }
    }

    cout << "YES" << endl;
    return 0;
}
